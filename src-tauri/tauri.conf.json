{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Attention",
  "identifier": "at.ring-dev.attention",
  "build": {
    "frontendDist": "../frontend/dist/attention-app/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "cd ./frontend && npm run start",
    "beforeBuildCommand": "cd ./frontend && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Attention",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/Wallabeng/attention/releases/latest/download/latest.json"
      ]
    }
  }
}
